#!/bin/bash

# default apps
export EDITOR="nvim"
export BROWSER="firefox"
export AUDIO_PLAYER="mpv"
export VIDEO_PLAYER="${AUDIO_PLAYER}"
export VECTOR_EDITOR="inkscape"
export IMAGE_EDITOR="gimp"
export DOCUMENT_EDITOR="libreoffice"


# file paths
export STUFF_PATH="$HOME/my_stuff"
export DOCUMENTS_PATH="$HOME/my_stuff/Documents"
export CONFIG_PATH="$HOME/.dotfiles"
