#!/bin/bash
source "$HOME/.bash_env"


encrypted="$DOCUMENTS_PATH/encrypted"
decrypted="$DOCUMENTS_PATH/decrypted"
journal="$decrypted/journal"
journal="$decrypted/journal"

#decrypt
echo "DECRYPTING..."
gocryptfs "$encrypted" "$decrypted"

#edit
$EDITOR "$journal"

#encrypt
echo "ENCRYPTING..."
fusermount -u "$decrypted"


