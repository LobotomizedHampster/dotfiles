#!/bin/bash
source "$HOME/.bash_env"

FILE_PATH="$HOME/.config/recap.conf"

print_file() {
    printf "\n"
    cat "$FILE_PATH"
}

edit_config() {
    "$EDITOR" "$FILE_PATH"
}

print_help() {
    printf "
-h --help   print this menu
-e --edit   edit the config file
-p --print  print the config file
"
}

YES_VALUE="#"
NO_VALUE=" "
MAYBE_VALUE="-"
write_answers() {
    local prompts answers q answer DATE answer_str

    # gets config file questions as an array
    mapfile -t prompts < <(awk '/^[0-9]. /' "$FILE_PATH")
    answers=()

    # prompt user with questions and add answers to an array
    for q in "${prompts[@]}"; do
        while true; do
            read -r -p "$q" answer
            case $answer in
                y|Y|yes|YES)
                    answers+=("$YES_VALUE")
                    break
                    ;;
                n|N|no|NO)
                    answers+=("$NO_VALUE")
                    break
                    ;;
                m|M|maybe|MAYBE)
                    answers+=("$MAYBE_VALUE")
                    break
                    ;;
            esac
        done
    done

    # get date and answers in a string
    DATE=$(date +%m-%d-%y)
    answer_str="${answers[*]}"

    # append text to the file
    printf "%s | %s\n" "$DATE" "$answer_str" >> "$FILE_PATH"

    print_file
}


# look for arguments
ARG="$1"

case "$ARG" in
    -p|p|--print|print)
        print_file
        ;;
    -h|h|--help|help)
        print_help
        ;;
    -e|e|--edit|edit)
        edit_config
        ;;
    *)
        write_answers
        ;;
esac
