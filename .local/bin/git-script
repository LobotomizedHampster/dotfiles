#!/bin/bash

# TODO:
# [ ] git log --oneline
# [ ] color support
# [ ] worktree adding
# [/] commit support
# [/] adding support
# [ ] reverting support
# [ ] --pretty:format log


printf "Choose an option:
- [A]dd files to snapshot
- [C]ommit changes
- [R]evert a change
- [L]og current commits
- [E]xit

"
invalid_option() {
    echo "Invalid option. Try again."
}

option_add() {
    printf "Selected add. \nAdd all files? [Y/n]:\n\n"
    while true; do
        
        read -rp "> " ADD_OPTION

        case "$ADD_OPTION" in
            y | Y | yes | Yes | YES | "")
                echo "Selected yes, adding all files."
                git add .
                break
                ;;
            n | N | no | No | NO )
                printf "Selected no, which files do you want to add then?\n\n"
                read -rp "> " ADD_FILES_OPTION
                echo "Ok, adding: $ADD_FILES_OPTION"
                git add $ADD_FILES_OPTION
                break
                ;;
            *)
                invalid_option
            ;;
        esac
    done
} 

option_commit() {
    printf "Selected commit. \nCommit message?\n\n"

    while true; do 

        read -rp "> " COMMIT_OPTION

        # if the string is empty (or contains only a space)
        if [[ -z "$COMMIT_OPTION" || "$COMMIT_OPTION" == " " ]]; then
            invalid_input
        else
            git commit -m "$COMMIT_OPTION"
            break
        fi
    done
}

option_log() {
    printf "Selected log. Showing Commit logs:\n\n"
    git log --max-count=18 \
        --pretty=format: "%C(yellow)%h  %C(green)%>|(21)%cr  %C(reset)%s"
}




while true; do

read -rp "> " MAIN_OPTION

	case "$MAIN_OPTION" in
	    a | A | add | Add )
            option_add
            break
	        ;;
	    c | C | commit | Commit )
            option_commit
            break
	        ;;
	    r | R | revert | Revert )
	        echo "selected r"
            break
	        ;;
	    l | L | log | Log )
	        option_log
            break
	        ;;
	    e | E | exit | Exit )
	        echo "Exiting..."
	        exit 0
            break
	        ;;
	    *)
            invalid_input
	
	esac
done
