#!/bin/bash

# TODO:
# [ ] push

INITIALIZED=false
ALL_ADDED=false
ALL_COMMITTED=false
REMOTE_UPDATED=false


if [[ -d ".git" ]]; then
    INITIALIZED=true

    #git fetch --quiet # gets changes from remote
    # name of remote
    #UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name @{u})

    if [[ -z "$(git diff --cached --quiet)" ]]; then
        ALL_ADDED=true
    elif [[ -z "$(git status --porcelain)" ]]; then
        ALL_COMMITTED=true
    elif [[ "$(git rev-list --count HEAD..$UPSTREAM)" -eq 0 ]]; then
        REMOTE_UPDATED=true
    fi
fi

#echo "$INITIALIZED"


option_invalid() {
    echo "Invalid option. Try again."
}

option_add() {
    printf "Selected add. \nAdd all files? [Y/n]:\n\n"
    while true; do
        
        read -rp "> " ADD_OPTION

        case "$ADD_OPTION" in
            y | Y | yes | Yes | YES | "")
                echo "Selected yes, adding all files."
                git add .
                break
                ;;
            n | N | no | No | NO )
                printf "Selected no, which files do you want to add then?\n\n"
                read -rp "> " ADD_FILES_OPTION
                echo "Ok, adding: $ADD_FILES_OPTION"
                git add $ADD_FILES_OPTION
                break
                ;;
            *)
                option_invalid
            ;;
        esac
    done
} 

option_commit() {
    printf "Selected commit. \nCommit message?\n\n"

    while true; do 

        read -rp "> " COMMIT_OPTION

        # if the string is empty (or contains only a space)
        if [[ -z "$COMMIT_OPTION" || "$COMMIT_OPTION" == " " ]]; then
            invalid_input
        else
            git commit -m "$COMMIT_OPTION"
            break
        fi
    done
}

option_log() {
    printf "Selected log. Showing Commit logs:\n\n"
    git log --max-count=18 \
        --pretty=format: "%C(yellow)%h  %C(green)%>|(21)%cr  %C(reset)%s"
}


if [[ $INITIALIZED == false ]]; then
    printf "%s\n" \
           "Choose an option:" \
            "- [I]nitalize a git repo" \
            "- [E]xit"
else
    printf "Choose an option:\n"
    if [[ $ALL_ADDED == false ]]; then
    printf -- "- [A]dd files to snapshot\n" # "--" is to treat string as data
    elif [[ $ALL_COMMITTED == false ]]; then
    printf -- "- [C]ommit changes\n"
    elif [[ $REMOTE_UPDATED == false ]]; then
    printf -- "- [P]ush to remote\n"
    fi
    printf "%s\n" \
           "- [R]evert a change" \
           "- [L]og current commits"
fi


while true; do

read -rp "> " MAIN_OPTION

	case "$MAIN_OPTION" in
	    a | A | add | Add )
            option_add
            break
	        ;;
	    c | C | commit | Commit )
            option_commit
            break
	        ;;
	    r | R | revert | Revert )
	        echo "selected r"
            break
	        ;;
	    l | L | log | Log )
	        option_log
            break
	        ;;
        i | I | init | Init )
            echo " "
            break
            ;;
	    e | E | exit | Exit )
	        echo "Exiting..."
	        exit 0
            break
	        ;;
	    *)
            invalid_input
	
	esac
done
