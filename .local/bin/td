#!/bin/bash
source "$HOME/.bash_env"


# prompt user for task name, due date, and due time
read -r -p "Task: " TASK
read -r -p "Date: " DATE
read -r -p "Time: " TIME


# check if $DATE is empty
# if it isn't add " | " (for formating)
if [[ -n $DATE ]]; then
	DATE_NEW="$DATE | "
else
	DATE_NEW=""
fi
# check if $TIME is empty
# if it isn't add " | " (for formating)
if [[ -n $TIME ]]; then
	TIME_NEW="$TIME | "
else
	TIME_NEW=""
fi

# append the text to the end of to-do
printf "[ ] %s%s%s\n" "$DATE_NEW" "$TIME_NEW" "$TASK" \
	>> "$DOCUMENTS_PATH/to-do"

# print the new file 
cat "$DOCUMENTS_PATH/to-do"
printf "\n\n"
