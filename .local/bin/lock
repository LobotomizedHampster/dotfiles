#!/bin/bash

i3lock \
--ignore-empty-password \
\
--blur=16 \
--screen=1 \
--color=$TRANSPARENT \
\
--verif-text="" \
--wrong-text="" \
--noinput-text="" \
--lock-text="locking" \
--lockfailed-text="lock failed" \
\
--inside-color=$TRANSPARENT \
--insidever-color=$TRANSPARENT \
--insidewrong-color=$TRANSPARENT \
--radius 510 \
--line-uses-inside \
--separator-color=$TRANSPARENT \
\
--ring-color=$ALPHA_BLACK \
--ringver-color=$ALPHA_BLUE \
--ringwrong-color=$ALPHA_RED \
--ring-width 100 \
\
--keyhl-color=$ALPHA_WHITE \
--bshl-color=$ALPHA_RED \
\
--force-clock \
--time-str="%I:%M %S" \
--time-font="$FONT" \
--time-color=$ALPHA_WHITE \
--time-size=100 \
--time-pos="ix:iy-25" \
\
--date-str="%A, %d-%m-%y" \
--date-font="$FONT" \
--date-color=$ALPHA_WHITE \
--date-size=50 \
--date-pos="ix:iy+25" \
&


# NOTES:
# - `--color` is set to avoid inital flickering

