#!/bin/bash

a=$1
b=$3
sign=$2 

round_to=3

math() { # returns the product of the expression in the argument
	local expr="$1"
	result=$(echo "$expr" | bc -l)
	echo "$result"
}

set -f   # disable globbing (allows for * operator)

# check if arguement 1 and 3 are integers or floating point numbers
if [[ ( "$a" =~ ^-?[0-9]+$ || "$a" =~ ^-?[0-9]*\.[0-9]+$ ) &&
      ( "$b" =~ ^-?[0-9]+$ || "$b" =~ ^-?[0-9]*\.[0-9]+$ ) ]]; then

	if   [ "$sign" == "+" ] || [ "$sign" == "plus" ]; then
		math "$a + $b"
			
	elif [ "$sign" == "-" ] || [ "$sign" == "minus" ]; then
		math "$a - $b"
	
	elif [ "$sign" == "x" ] || [ "$sign" == "product" ]; then
		math "$a * $b"
	
	elif [ "$sign" == "/" ] || [ "$sign" == "divide" ]; then
		math "$a / $b"
	
	elif [ "$sign" == "^" ] || [ "$sign" == "power" ]; then
		math "$a ^ $b"
	
	elif [ "$sign" == "RT" ] || [ "$sign" == "root" ]; then
		math "e(l($b) / $a)"

	else
		invalid_operator_text="ERROR: wrong or missing operator, valid operators are:
       +/plus    | addition
       -/minus   | subtraction
       */product | multiplcation
       //divide  | division
       ^/power   | exponentiation
       RT/root   | root extraction
		"
		echo "$invalid_operator_text"
	fi
else
	invalid_number_text="ERROR: either the first number, the second number,
       or both numbers are missing or invalid. the numbers should be either a:
       - integer (e.g. 8, 42, -9)
       - floating point number (e.g. 8.0, 6.9, 4.723)"

	echo "$invalid_number_text"
fi


