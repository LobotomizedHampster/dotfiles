#!/bin/bash

source "$HOME/.bash_env"


# Main menu
main_menu="apps\nconfigs\nopen"
choice=$(echo -e "$main_menu" | dmenu)

case "$choice" in
    "apps")
        apps_menu="browser\nmusic\nlibreoffice\ngimp\ninkscape\nscreenshot\nvirtualbox\nbrave"
        app_choice=$(echo -e "$apps_menu" | dmenu -p "Apps:")
        case "$app_choice" in
            "browser") librewolf -P "default-default" ;;
            "music") librewolf -P "Music" ;;
            "libreoffice") libreoffice ;;
            "gimp") gimp ;;
            "inkscape") inkscape ;;
            "screenshot") flameshot gui ;;
            "virtualbox") virtualbox ;;
            "brave") brave ;;
        esac
        ;;


    "configs")
        configs_menu="qtile\npicom\nkitty\nranger\nrofi\nnvim\ndunst\nconky\nlibrewolf\nbashrc\nxinitrc\nxprofile\n.local/bin\ndmenu"
        configs_choice=$(echo -e "$configs_menu" | dmenu -p "configs:")
        case "$configs_choice" in
	    "qtile") kitty -e ranger "$HOME/.config/qtile/" ;;
            "picom") kitty -e nvim "$HOME/.config/picom/picom.conf" ;;
            "kitty") kitty -e ranger "$HOME/.config/kitty/" ;;
            "ranger") kitty -e ranger "$HOME/.config/ranger/" ;;
            "rofi") kitty -e ranger "$HOME/.config/rofi/" ;;
            "nvim") kitty -e ranger "$HOME/.config/nvim/" ;;
            "dunst") kitty -e nvim "$HOME/.config/dunst/dunstrc" ;;
            "conky") kitty -e ranger "$HOME/.config/conky/" ;;
            "librewolf") kitty -e ranger "$HOME/.librewolf" ;;
            "bashrc") kitty -e nvim "$HOME/.bashrc" ;;
            "xinitrc") kitty -e nvim "$HOME/.xinitrc" ;;
            "xprofile") kitty -e nvim "$HOME/.xprofile" ;;
            ".local/bin") kitty -e ranger "$HOME/.local/bin/" ;;
            "dmenu") kitty -e ranger "$HOME/dmenu/" ;;
        esac
        ;;

	"open")
        open_menu="my_stuff\nmy_dotfiles\n.config\n"
        open_choice=$(echo -e "$open_menu" | dmenu -p "open:")
        case "$open_choice" in
            "my_stuff") kitty -e ranger "$HOME/my_stuff/" ;;
            "my_dotfiles") kitty -e ranger "$HOME/my_dotfiles/" ;;
            ".config") kitty -e ranger "$HOME/.config/" ;;
        esac
        ;;
esac

