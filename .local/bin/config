#!/bin/bash

source "$HOME/.bash_env"

CHOICE="$1"

# print options
printf "Choose an option: \n
01.) qtile
02.) picom
03.) kitty
04.) ranger
05.) rofi
06.) nvim
07.) dunst
08.) conky
09.) browser
10.) bashrc
11.) xinitrc
12.) xprofile
13.) .local/bin
14.) dmenu

"

# get input if no arg supplied
read -rp "enter a value: " CHOICE

CONFIG_PATH="$HOME/.dotfiles" # path for config files

# define reach number in the options
case "$CHOICE" in
    "1"|"01") "$FILE_MGR" "$CONFIG_PATH/.config/qtile/" ;;
    "2"|"02") "$FILE_MGR" "$CONFIG_PATH/.config/picom/" ;;
    "3"|"03") "$FILE_MGR" "$CONFIG_PATH/.config/kitty/" ;;
    "4"|"04") "$FILE_MGR" "$CONFIG_PATH/.config/ranger/" ;;
    "5"|"05") "$FILE_MGR" "$CONFIG_PATH/.config/rofi/" ;;
    "6"|"06") "$FILE_MGR" "$CONFIG_PATH/.config/nvim/" ;;
    "7"|"07") "$FILE_MGR" "$CONFIG_PATH/.config/dunst/" ;;
    "8"|"08") "$FILE_MGR" "$CONFIG_PATH/.config/conky/" ;;
    "9"|"09") "$FILE_MGR" "$CONFIG_PATH/.zen/" ;;
    "10"|"10") "$EDITOR" "$CONFIG_PATH/.bashrc" ;;
    "11"|"11") "$EDITOR" "$CONFIG_PATH/.xinitrc" ;;
    "12"|"12") "$EDITOR" "$CONFIG_PATH/.xprofile" ;;
    "13"|"13") "$FILE_MGR" "$CONFIG_PATH/.local/bin/" ;;
    "14"|"14") "$FILE_MGR" "$CONFIG_PATH/compiled/dmenu/" ;;
esac
