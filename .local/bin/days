#!/bin/bash

# when event started
START_DATE="2025-12-14"

# formating
start_ts=$(date -d "$START_DATE" +%s)
now_ts=$(date +%s)
diff_seconds=$(( now_ts - start_ts ))
diff_days=$(( diff_seconds / 86400 ))

result=$(awk -v a="$diff_days" 'BEGIN { print a / 180 }') # find the quotient of $diff_days with awk
result_percent=$(awk -v a="$result" 'BEGIN { printf "%.2f", a * 100 }') # multiply by 100


echo "$diff_days/180 days since $START_DATE"
printf "You're $result_percent%% of the way there!! \n"
