#!/bin/bash

{
    echo "remove 70:37:3F:56:4D:B0"
    echo "power off"
    sleep 1
    echo "power on"
    sleep 1
    echo "agent on"
    echo "default-agent"
    sleep 1
    echo "scan on"
    sleep 10
    echo "trust 70:37:3F:56:4D:B0"
    echo "connect 70:37:3F:56:4D:B0"
    sleep 10
} | bluetoothctl
